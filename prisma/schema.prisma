// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum WordStatus {
  PENDING
  PUBLISHED
  REJECTED
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String? // null for OAuth-only users
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())

  accounts       Account[]
  sessions       Session[]
  submittedWords WordMeaning[] @relation("SubmittedWords")
  reviewedWords  WordMeaning[] @relation("ReviewedWords")
  wordReports    WordReport[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// The lexical headword. One row per distinct spelling — every WordMeaning
// under it is a separate sense of the same word, shown together rather than
// as unrelated entries. Tags describe the word as a whole (not one sense),
// so they live here even when the underlying senses were originally tagged
// differently — those get unioned onto the word.
model Word {
  id        String   @id @default(cuid())
  slug      String   @unique
  word      String
  createdAt DateTime @default(now())

  meanings WordMeaning[]
  tags     Tag[]
  reports  WordReport[]

  // Both the "did you know this word" poll and the usefulness rating are
  // questions about the whole word, not one sense, so both live here.
  knewCount      Int @default(0)
  didntKnowCount Int @default(0)
  usefulCount    Int @default(0)
  notUsefulCount Int @default(0)

  @@index([word])
  @@map("words")
}

// A single assignable label (archaic, dialect, ...). A normalized model
// rather than a hardcoded list so the vocabulary can grow later without a
// code change — add a row (via the seed script or directly) to make a new
// tag assignable.
model Tag {
  id    String @id @default(cuid())
  slug  String @unique
  label String
  order Int    @default(0)

  words Word[]

  @@map("tags")
}

// One sense/definition of a Word. Everything that can differ between
// meanings of the same word (part of speech, the definition text,
// moderation status) lives here. Tags and the poll/usefulness counters do
// not — see Word.
model WordMeaning {
  id        String     @id @default(cuid())
  pos       String?
  meaning   String     @db.Text
  status    WordStatus @default(PENDING)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  wordId String
  word   Word   @relation(fields: [wordId], references: [id], onDelete: Cascade)

  submittedById String?
  submittedBy   User?   @relation("SubmittedWords", fields: [submittedById], references: [id], onDelete: SetNull)

  reviewedById    String?
  reviewedBy      User?     @relation("ReviewedWords", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt      DateTime?
  rejectionReason String?   @db.Text

  @@index([status])
  @@index([wordId])
  @@map("word_meanings")
}

// Flags/proposes a change to a Word as a whole. Meaning text isn't editable
// through a report (that's an admin-only per-meaning action via
// EditWordButton) — a report can only propose a new tag set for the word,
// plus a freeform message for anything else (e.g. "the 2nd meaning is
// misworded").
model WordReport {
  id           String   @id @default(cuid())
  message      String?  @db.Text
  proposedTags String[] @default([])
  createdAt    DateTime @default(now())

  wordId String
  word   Word   @relation(fields: [wordId], references: [id], onDelete: Cascade)

  reporterId String?
  reporter   User?   @relation(fields: [reporterId], references: [id], onDelete: SetNull)

  @@index([wordId])
  @@map("word_reports")
}
